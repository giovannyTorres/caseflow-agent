APP_MODE=DEMO
APP_ORIGIN=http://localhost:3102
COOKIE_SECURE=false
MODEL_PROVIDER=openai
MODEL_NAME=gpt-4.1-mini
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_TOKENS=1200
OPENAI_API_KEY=
GEMINI_API_KEY=
# Local simulator credentials only; replace for non-local deployments.
POSTGRES_PASSWORD=caseflow-demo

# Maximum entire durable graph invocation, including MCP and model calls.
EXECUTION_TIMEOUT_SECONDS=180

# Optional LIVE semantic definitions. DEMO/off never contact NVIDIA.
ONTOLOGY_MODE=off
ONTOLOGY_REQUIRED=false
ONTOLOGY_SNAPSHOT_PATH=
ONTOLOGY_SNAPSHOT_SHA256=
ONTOLOGY_TIMEOUT_SECONDS=5
AUTO_ONTOLOGY_URL=
AUTO_ONTOLOGY_API_TOKEN=
